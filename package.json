{
  "name": "dropmmssgg-static-performance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8788",
